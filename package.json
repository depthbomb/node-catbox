{
	"name": "node-catbox",
	"version": "4.2.0",
	"author": "depthbomb",
	"description": "A library for interacting with Catbox.moe written in TypeScript.",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"catbox.moe",
		"catbox",
		"typescript",
		"fetch",
		"api"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/depthbomb/node-catbox.git"
	},
	"bugs": {
		"url": "https://github.com/depthbomb/node-catbox/issues"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dist": "tsdown",
		"test": "yarn dist && vitest",
		"release": "yarn dist && release-it",
		"lint": "eslint ./src --ext .ts"
	},
	"devDependencies": {
		"@tsconfig/node24": "^24.0.4",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.12.2",
		"@typescript-eslint/eslint-plugin": "^8.58.2",
		"@typescript-eslint/parser": "^8.58.2",
		"dotenv": "^17.4.2",
		"eslint": "^10.2.1",
		"release-it": "^20.0.0",
		"terser": "^5.46.1",
		"tsdown": "^0.21.9",
		"typescript": "^6.0.3",
		"vitest": "^4.1.4"
	},
	"packageManager": "yarn@4.14.1"
}
