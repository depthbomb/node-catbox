{
	"name": "node-catbox",
	"version": "6.0.0",
	"author": "depthbomb",
	"description": "A library for interacting with Catbox.moe written in TypeScript.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"catbox.moe",
		"catbox",
		"typescript",
		"fetch",
		"api"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/index.d.mts",
				"require": "./dist/index.d.cts"
			},
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/depthbomb/node-catbox.git"
	},
	"bugs": {
		"url": "https://github.com/depthbomb/node-catbox/issues"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dist": "tsdown",
		"test": "yarn dist && vitest run",
		"typecheck": "yarn dist && tsc --noEmit && tsc --project tsconfig.test.json",
		"release": "yarn dist && release-it",
		"lint": "oxlint src tests tsdown.config.ts",
		"smoke": "node -e \"const p = require('node-catbox'); if (!p.Catbox || !p.Litterbox) process.exit(1)\" && node --input-type=module -e \"import { Catbox, Litterbox } from 'node-catbox'; if (!Catbox || !Litterbox) process.exit(1)\"",
		"check": "yarn lint && yarn typecheck && vitest run && yarn smoke",
		"prepack": "yarn dist"
	},
	"devDependencies": {
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.13.3",
		"dotenv": "^17.4.2",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"release-it": "^21.0.2",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"packageManager": "yarn@4.18.0"
}
